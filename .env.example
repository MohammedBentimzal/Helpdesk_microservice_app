# Copy to .env (npm run setup does this for you). Never commit .env.

# ---------- shared ----------
# Secret used to sign login tokens (JWT). Use a long random value outside local development.
JWT_SECRET=change-me-to-a-long-random-string
LOG_LEVEL=info

# ---------- authentication ----------
# dev    = demo login buttons, no Google account needed (default, local use only)
# google = real Google sign-in (needs GOOGLE_CLIENT_ID below)
AUTH_MODE=dev
GOOGLE_CLIENT_ID=
# Comma-separated emails that get the "agent" role when they sign in with Google
AGENT_EMAILS=ahmed@example.com

# ---------- databases (match docker-compose.infra.yml) ----------
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk_pw
POSTGRES_DB=helpdesk_tickets
MYSQL_ROOT_PASSWORD=root_pw
MYSQL_USER=helpdesk
MYSQL_PASSWORD=helpdesk_pw

# Connection strings used by the services when running locally.
# In containers/Kubernetes each service simply gets its own DATABASE_URL instead.
TICKET_DB_URL=postgres://helpdesk:helpdesk_pw@localhost:5432/helpdesk_tickets
AUTH_DB_URL=mysql://helpdesk:helpdesk_pw@localhost:3306/helpdesk_auth
NOTIFICATIONS_DB_URL=mysql://helpdesk:helpdesk_pw@localhost:3306/helpdesk_notifications
REDIS_URL=redis://localhost:6379

# ---------- ports ----------
AUTH_PORT=4001
TICKET_PORT=4002
NOTIFICATION_PORT=4003

# ---------- ticket-service ----------
# Insert 3 sample tickets when the tickets table is empty
SEED_DEMO_DATA=true

# ---------- notification-service ----------
# Optional: also post notifications to a Discord channel
DISCORD_WEBHOOK_URL=

# ---------- chaos / failure injection (for reliability drills) ----------
# none | slow | error | crash   (applies to every service that loads this file)
CHAOS_MODE=none
CHAOS_DELAY_MS=2000
CHAOS_ERROR_RATE=0.5
# Set a token to enable POST /chaos for changing the mode at runtime
CHAOS_TOKEN=
